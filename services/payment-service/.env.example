APP_NAME=PaymentService
APP_ENV=local
APP_KEY=
# Must exactly match Auth Service AUTH_TOKEN_KEY; never copy APP_KEY here.
AUTH_TOKEN_KEY=
# Must match Gateway and every trusted service; never expose it to clients.
INTERNAL_SERVICE_TOKEN=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8004
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=bstore_payment
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=bstore_payment_db
DB_USERNAME=root
DB_PASSWORD=

ORDER_SERVICE_URL=http://127.0.0.1:8003
MICROSERVICE_CONNECT_TIMEOUT=2
MICROSERVICE_TIMEOUT=5

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_IPN_URL=http://localhost:8000/api/payments/vnpay/ipn
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_REFUND_USER=bstore-system
VNPAY_TIMEZONE=Asia/Ho_Chi_Minh

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
